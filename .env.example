# Copy to .env.local for local development, set the same keys in your host for production.

# Public base URL — used for canonical links, sitemap, robots, Open Graph images, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example

# Enquiry form delivery (server-only — never prefix with NEXT_PUBLIC_). Configure ONE option.
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# a sender on a domain verified in Resend, e.g. "Website <enquiries@your-domain.example>"
ENQUIRY_FROM_EMAIL=

# Option B: JSON webhook (Make, Zapier, Slack incoming webhook, Formspree…)
ENQUIRY_WEBHOOK_URL=
